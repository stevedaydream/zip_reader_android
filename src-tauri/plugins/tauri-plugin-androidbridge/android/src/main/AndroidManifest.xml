<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 掃描使用者指定資料夾（Android 11+ 的「所有檔案存取」） -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 朗讀時保持 CPU 運作，螢幕關閉仍能連續換章 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前景服務：豁免 Doze 背景網路限制，螢幕關閉換章不中斷 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.comicreader.bridge.TtsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- 桌面遙控 widget：暫停/繼續、停止（僅朗讀中可用） -->
        <receiver
            android:name="com.comicreader.bridge.NovelWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/novel_widget_info" />
        </receiver>
    </application>
</manifest>
